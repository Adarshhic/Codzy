# Backend API URL (Production backend URL without trailing slash)
VITE_API_URL=https://your-backend-api.onrender.com

# Backend Socket.io URL (Same as backend API URL)
VITE_SOCKET_URL=https://your-backend-api.onrender.com

# Stream.io Public API Key (Video calls & Chat)
VITE_STREAM_API_KEY=your_stream_api_key_here
