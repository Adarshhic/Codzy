datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  User
  Admin
}

enum GroupMemberRole {
  admin
  moderator
  member
}

enum GroupSessionStatus {
  active
  completed
  archived
}

enum InterviewStatus {
  waiting
  active
  completed
  cancelled
}

model User {
  id               String               @id // Preserved MongoDB ObjectId string
  FirstName        String
  LastName         String?
  EmailId          String               @unique
  age              Int?
  role             Role                 @default(User)
  password         String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  problemsCreated  Problem[]            @relation("ProblemCreator")
  submissions      Submission[]
  solutionVideos   SolutionVideo[]
  studyGroupsOwned StudyGroup[]         @relation("GroupCreator")
  groupMemberships GroupMember[]
  groupMessages    GroupMessage[]
  groupSessions    GroupSession[]       @relation("SessionCreator")
  solvedProblems   UserSolvedProblem[]
  interviewsHosted InterviewSession[]   @relation("Interviewer")
  interviewsJoined InterviewSession[]   @relation("Candidate")
  progressSolved   GroupProgressSolver[]

  @@map("users")
}

model Problem {
  id                 String              @id // Preserved MongoDB ObjectId string
  title              String
  description        String
  difficulty         String              // Easy, Medium, Hard
  tags               String
  visibleTestCases   Json                // [{ input: [], output: [], explanation: "" }]
  hiddenTestCases    Json                // [{ input: [], output: [] }]
  startCode          Json                // [{ Language: "", initialCode: "" }]
  referenceSolutions Json                // [{ language: "", CompleteCode: "" }]
  problemCreatorId   String              // Foreign Key -> User.id
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  problemCreator     User                @relation("ProblemCreator", fields: [problemCreatorId], references: [id], onDelete: Cascade)
  submissions        Submission[]
  solutionVideos     SolutionVideo[]
  groupSessions      GroupSession[]
  groupProgress      GroupProgress[]
  userSolvers        UserSolvedProblem[]
  interviewSessions  InterviewSession[]

  @@map("problems")
}

model UserSolvedProblem {
  userId    String // Preserved User._id string
  problemId String // Preserved Problem._id string
  solvedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@id([userId, problemId])
  @@map("user_solved_problems")
}

model Submission {
  id              String   @id // Preserved MongoDB ObjectId string
  userId          String   // Foreign Key -> User.id
  problemId       String   // Foreign Key -> Problem.id
  code            String
  language        String
  status          String   @default("pending")
  runtime         Float    @default(0)
  memory          Float    @default(0)
  errorMessage    String   @default("")
  testCasesPassed Int      @default(0)
  testCasesTotal  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem         Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId, problemId])
  @@map("submissions")
}

model SolutionVideo {
  id                 String   @id // Preserved MongoDB ObjectId string
  problemId          String   // Foreign Key -> Problem.id
  userId             String   // Foreign Key -> User.id
  cloudinaryPublicId String   @unique
  secureUrl          String
  thumbnailUrl       String?
  duration           Float
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  problem            Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("solution_videos")
}

model StudyGroup {
  id          String         @id // Preserved MongoDB ObjectId string
  name        String
  description String?
  inviteCode  String         @unique
  createdBy   String         // Foreign Key -> User.id
  maxMembers  Int            @default(50)
  isPrivate   Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  creator     User           @relation("GroupCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  members     GroupMember[]
  messages    GroupMessage[]
  sessions    GroupSession[]
  progress    GroupProgress[]

  @@index([inviteCode])
  @@map("study_groups")
}

model GroupMember {
  id         String          @id // Preserved MongoDB ObjectId string
  groupId    String          // Foreign Key -> StudyGroup.id
  userId     String          // Foreign Key -> User.id
  role       GroupMemberRole @default(member)
  joinedAt   DateTime        @default(now())
  lastActive DateTime        @default(now())

  group      StudyGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_members")
}

model GroupSession {
  id        String             @id // Preserved MongoDB ObjectId string
  groupId   String             // Foreign Key -> StudyGroup.id
  problemId String             // Foreign Key -> Problem.id
  createdBy String             // Foreign Key -> User.id
  status    GroupSessionStatus @default(active)
  startedAt DateTime           @default(now())
  endedAt   DateTime?

  group     StudyGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  problem   Problem            @relation(fields: [problemId], references: [id], onDelete: Cascade)
  creator   User               @relation("SessionCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  messages  GroupMessage[]

  @@map("group_sessions")
}

model GroupMessage {
  id          String        @id // Preserved MongoDB ObjectId string
  groupId     String        // Foreign Key -> StudyGroup.id
  sessionId   String?       // Foreign Key -> GroupSession.id (Nullable)
  userId      String        // Foreign Key -> User.id
  message     String
  messageType String        @default("text")
  createdAt   DateTime      @default(now())

  group       StudyGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  session     GroupSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@map("group_messages")
}

model GroupProgress {
  id          String                @id // Preserved MongoDB ObjectId string
  groupId     String                // Foreign Key -> StudyGroup.id
  problemId   String                // Foreign Key -> Problem.id
  completedAt DateTime?
  createdAt   DateTime              @default(now())

  group       StudyGroup            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  problem     Problem               @relation(fields: [problemId], references: [id], onDelete: Cascade)
  solvers     GroupProgressSolver[]

  @@unique([groupId, problemId])
  @@map("group_progress")
}

model GroupProgressSolver {
  progressId String // Preserved GroupProgress.id string
  userId     String // Preserved User.id string
  solvedAt   DateTime @default(now())

  progress   GroupProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([progressId, userId])
  @@map("group_progress_solvers")
}

model InterviewSession {
  id            String          @id // Preserved MongoDB ObjectId string
  problemId     String          // Foreign Key -> Problem.id
  difficulty    String
  interviewerId String          // Foreign Key -> User.id
  candidateId   String?         // Foreign Key -> User.id (Nullable)
  status        InterviewStatus @default(waiting)
  callId        String          @unique
  startedAt     DateTime?
  endedAt       DateTime?
  notes         String          @default("")
  rating        Int?
  codeSnapshot  String          @default("")
  language      String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  problem       Problem         @relation(fields: [problemId], references: [id], onDelete: Cascade)
  interviewer   User            @relation("Interviewer", fields: [interviewerId], references: [id], onDelete: Cascade)
  candidate     User?           @relation("Candidate", fields: [candidateId], references: [id], onDelete: SetNull)

  @@index([status, candidateId])
  @@map("interview_sessions")
}
