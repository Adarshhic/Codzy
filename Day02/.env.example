# Server Configuration
PORT=5000
NODE_ENV=production

# Frontend Client URL (comma-separated for multiple origins, no trailing slash)
CLIENT_URL=https://your-app.vercel.app,http://localhost:5173

# Database (MongoDB Atlas)
DB_CONNECTION_STRING=mongodb+srv://<username>:<password>@cluster0.mongodb.net/Leetcode?retryWrites=true&w=majority

# JWT Authentication
JWT_KEY=your_super_secret_jwt_key_here_min_32_chars

# Redis (e.g. Upstash, Redis Cloud, Railway Redis)
# Option 1: Complete connection URL (Recommended for cloud providers)
REDIS_URL=rediss://default:<password>@<host>:<port>

# Option 2: Individual connection parameters (Fallback)
# REDIS_HOST=your-redis-host.redislabs.com
# REDIS_PORT=10468
# REDIS_USERNAME=default
# REDIS_PASSWORD=your_redis_password

# Google Gemini AI API
GEMINI_KEY=your_gemini_api_key_here

# Cloudinary (Media / Video solutions)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Stream.io (Video Calls & Live Chat)
STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret
